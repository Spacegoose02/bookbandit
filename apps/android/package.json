{
  "name": "@bookbandit/android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BookBandit for Android tablets: a Capacitor shell around apps/web",
  "scripts": {
    "build": "vite build && vite build -c vite.shim.config.ts && node scripts/assemble-www.mjs",
    "sync": "pnpm build && cap sync android",
    "apk": "pnpm sync && cd android && ./gradlew assembleDebug",
    "preview": "vite preview --port 4174 --outDir ../www --base /",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@bookbandit/web": "workspace:*",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
