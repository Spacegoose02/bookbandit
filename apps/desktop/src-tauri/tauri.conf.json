{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookBandit",
  "version": "0.1.0",
  "identifier": "app.bookbandit.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "BookBandit",
    "shortDescription": "Your family's BookBandit library on Windows",
    "longDescription": "Reads from your family's self-hosted BookBandit server, with books saved for offline reading.",
    "category": "Education",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
